{
  "expo": {
    "name": "Quitte",
    "slug": "quitte",
    "scheme": "quitte",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "nl.zichtwerf.quitte",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Quitte gebruikt de camera om QR-codes van lijsten te scannen en bonnetjes te fotograferen.",
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "nl",
          "en"
        ],
        "CFBundleDevelopmentRegion": "nl",
        "NSPhotoLibraryUsageDescription": "Quitte gebruikt je fotogalerij om een bonnetje bij een uitgave te bewaren."
      },
      "associatedDomains": [
        "applinks:quitte-app.vercel.app"
      ]
    },
    "android": {
      "package": "nl.zichtwerf.quitte",
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Quitte gebruikt de camera om QR-codes van lijsten te scannen en bonnetjes te fotograferen.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0F17"
          }
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Quitte gebruikt je fotogalerij om een bonnetje bij een uitgave te bewaren.",
          "cameraPermission": "Quitte gebruikt de camera om QR-codes van lijsten te scannen en bonnetjes te fotograferen.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "mode": "production",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-apple-authentication",
      "expo-sharing",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}