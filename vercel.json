{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/facturen/",
      "destination": "/#facturen",
      "permanent": true
    },
    {
      "source": "/btw-bank/",
      "destination": "/#btw",
      "permanent": true
    },
    {
      "source": "/rapportages/",
      "destination": "/#rapportages",
      "permanent": true
    },
    {
      "source": "/hoe-het-werkt/",
      "destination": "/#hoe",
      "permanent": true
    },
    {
      "source": "/voor-ondernemers/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/over/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/support/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
