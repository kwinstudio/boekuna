{
  "name": "wfm-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate-if-configured.mjs && next build",
    "start": "next start -H 0.0.0.0 -p $PORT",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "jose": "6.1.0",
    "next": "16.3.6",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.2",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.6"
  }
}
