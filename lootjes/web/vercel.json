{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/j/:code",
      "destination": "/"
    },
    {
      "source": "/m/:token",
      "destination": "/"
    },
    {
      "source": "/privacy",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}