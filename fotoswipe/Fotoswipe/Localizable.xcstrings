    },
    "Je keuzes blijven behouden als je wisselt. Weggelegde items uit alle categorieën controleer je samen in Bekijken.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your choices are kept when you switch. You review set-aside items from all categories together in Review."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je keuzes blijven behouden als je wisselt. Weggelegde items uit alle categorieën controleer je samen in Bekijken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus decisiones se mantienen al cambiar. Los elementos apartados de todas las categorías los revisas juntos en Revisar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Entscheidungen bleiben beim Wechseln erhalten. Beiseitegelegte Objekte aus allen Kategorien prüfst du gemeinsam unter „Prüfen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes choix sont conservés quand tu changes. Tu vérifies ensemble les éléments mis de côté de toutes les catégories dans Vérifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替えても選択内容は保持されます。すべてのカテゴリでよけた項目は「確認」でまとめてチェックできます。"
          }
        }
      }
    },
    "Je keuzes konden niet worden opgeslagen. Houd de app open en probeer later opnieuw.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your choices couldn't be saved. Keep the app open and try again later."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je keuzes konden niet worden opgeslagen. Houd de app open en probeer later opnieuw."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar tus decisiones. Mantén la app abierta e inténtalo más tarde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Entscheidungen konnten nicht gesichert werden. Lass die App geöffnet und versuche es später erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer tes choix. Garde l'app ouverte et réessaie plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択内容を保存できませんでした。アプリを開いたまま、あとでもう一度お試しください。"
          }
        }
      }
    },
    "Je kunt dit later altijd wijzigen in Instellingen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can always change this later in Settings."
