            "value": "Fotoswipe"
          }
        }
      }
    },
    "Fotoswipe bekijkt kleine voorbeelden van je recentste foto's, alleen op je iPhone. Het is een voorstel: jij beslist altijd zelf, en favorieten komen nooit in Rommel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoswipe looks at small previews of your most recent photos, only on your iPhone. It's a suggestion: you always decide, and favorites never end up in Clutter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoswipe bekijkt kleine voorbeelden van je recentste foto's, alleen op je iPhone. Het is een voorstel: jij beslist altijd zelf, en favorieten komen nooit in Rommel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoswipe analiza vistas previas pequeñas de tus fotos más recientes, solo en tu iPhone. Es una sugerencia: siempre decides tú, y los favoritos nunca van a Desorden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoswipe prüft kleine Vorschauen deiner neuesten Fotos, nur auf deinem iPhone. Es ist ein Vorschlag: Du entscheidest immer selbst, und Favoriten landen nie bei Kram."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoswipe examine de petits aperçus de tes photos les plus récentes, seulement sur ton iPhone. C'est une suggestion : c'est toujours toi qui décides, et tes favoris ne vont jamais dans Fouillis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoswipeは最近の写真の小さなプレビューをiPhone上だけで確認します。あくまで提案なので、最終的に決めるのはあなたです。お気に入りが「不要な写真」に入ることはありません。"
          }
        }
      }
    },
    "Fotoswipe heeft je foto's nodig": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoswipe needs your photos"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoswipe heeft je foto's nodig"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoswipe necesita tus fotos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoswipe braucht deine Fotos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoswipe a besoin de tes photos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoswipeには写真へのアクセスが必要です"
          }
        }
      }
    },
    "Fototoegang is beperkt op dit apparaat. Controleer Schermtijd of het apparaatbeheer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo access is restricted on this device. Check Screen Time or device management."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fototoegang is beperkt op dit apparaat. Controleer Schermtijd of het apparaatbeheer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a las fotos está restringido en este dispositivo. Revisa Tiempo de uso o la gestión del dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fotozugriff ist auf diesem Gerät eingeschränkt. Prüfe Bildschirmzeit oder die Geräteverwaltung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès aux photos est restreint sur cet appareil. Vérifie Temps d'écran ou la gestion de l'appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは写真へのアクセスが制限されています。スクリーンタイムまたはデバイス管理を確認してください。"
          }
        }
      }
    },
    "Gebaren in Focus": {
