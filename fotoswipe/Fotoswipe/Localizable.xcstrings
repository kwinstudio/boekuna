{
  "sourceLanguage": "en",
  "strings": {
    "%@\nGeen reclame, geen abonnement, geen limiet. Je foto's blijven op je iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nNo ads, no subscription, no limits. Your photos stay on your iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nGeen reclame, geen abonnement, geen limiet. Je foto's blijven op je iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nSin anuncios, sin suscripción, sin límites. Tus fotos se quedan en tu iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nKeine Werbung, kein Abo, kein Limit. Deine Fotos bleiben auf deinem iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nPas de pub, pas d'abonnement, pas de limite. Tes photos restent sur ton iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n広告なし、サブスクリプションなし、制限なし。写真はiPhoneに保存されたままです。"
          }
        }
      }
    },
