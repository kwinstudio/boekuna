    "Grootste eerst zet video's en grote foto's vooraan: snel veel ruimte.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Biggest first puts videos and large photos up front: lots of space, fast."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grootste eerst zet video's en grote foto's vooraan: snel veel ruimte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más grandes primero pone delante los vídeos y las fotos grandes: mucho espacio, rápido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Größte zuerst“ zeigt Videos und große Fotos zuerst: schnell viel Platz."
