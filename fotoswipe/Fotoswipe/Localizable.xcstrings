    "Geef Fotoswipe eerst toegang tot je foto's.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give Fotoswipe access to your photos first."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef Fotoswipe eerst toegang tot je foto's."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero da acceso a Fotoswipe a tus fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Fotoswipe zuerst den Zugriff auf deine Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne d'abord à Fotoswipe l'accès à tes photos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずFotoswipeに写真へのアクセスを許可してください。"
          }
        }
      }
    },
    "Geef Fotoswipe toegang bij Instellingen om te beginnen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give Fotoswipe access in Settings to get started."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef Fotoswipe toegang bij Instellingen om te beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da acceso a Fotoswipe en Ajustes para empezar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Fotoswipe in den Einstellungen den Zugriff, um loszulegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne l'accès à Fotoswipe dans Réglages pour commencer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "始めるには、「設定」でFotoswipeにアクセスを許可してください。"
          }
        }
      }
    },
    "Geef Fotoswipe toegang in Instellingen om dubbele contacten te vinden. Je contacten blijven op je iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give Fotoswipe access in Settings to find duplicate contacts. Your contacts stay on your iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef Fotoswipe toegang in Instellingen om dubbele contacten te vinden. Je contacten blijven op je iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da acceso a Fotoswipe en Ajustes para encontrar contactos duplicados. Tus contactos se quedan en tu iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Fotoswipe in den Einstellungen den Zugriff, um doppelte Kontakte zu finden. Deine Kontakte bleiben auf deinem iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise Fotoswipe dans Réglages pour trouver les contacts en double. Tes contacts restent sur ton iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重複した連絡先を探すには、設定でFotoswipeにアクセスを許可してください。連絡先はiPhoneの中だけで処理されます。"
          }
        }
      }
    },
