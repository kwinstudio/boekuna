    "Veeg naar rechts om te bewaren, naar links om weg te leggen, omhoog voor later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe right to keep, left to set aside, up for later."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg naar rechts om te bewaren, naar links om weg te leggen, omhoog voor later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a la derecha para conservar, a la izquierda para apartar y hacia arriba para decidir luego."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische nach rechts zum Behalten, nach links zum Beiseitelegen, nach oben für später."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaye vers la droite pour garder, vers la gauche pour mettre de côté, vers le haut pour plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
