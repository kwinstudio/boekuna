    "Foto's zonder locatie verschijnen hier niet. Zet locatie aan in de Camera-instellingen voor nieuwe foto's.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos without a location don't appear here. Turn on location for the Camera to include new photos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto's zonder locatie verschijnen hier niet. Zet locatie aan in de Camera-instellingen voor nieuwe foto's."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos sin ubicación no aparecen aquí. Activa la ubicación para la Cámara para incluir las nuevas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos ohne Ort erscheinen hier nicht. Aktiviere Ortungsdienste für die Kamera, damit neue Fotos dazukommen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos sans lieu n'apparaissent pas ici. Active la localisation pour l'appareil photo pour les nouvelles photos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報のない写真は表示されません。新しい写真に位置情報を付けるには、カメラの位置情報をオンにしてください。"
          }
        }
      }
    },
    "Fotoswipe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoswipe"
          }
        },
        "nl": {
          "stringUnit": {
