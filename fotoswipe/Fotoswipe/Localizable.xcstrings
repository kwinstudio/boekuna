            "state": "translated",
            "value": "Siempre puedes cambiarlo más tarde en Ajustes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst das später jederzeit in den Einstellungen ändern."
          }
        },
        "fr": {
