    "Bij beperkte fototoegang zijn sommige categorieën en albums niet beschikbaar. Via Wijzig of Instellingen pas je de toegang aan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With limited photo access, some categories and albums aren't available. Change access via Edit or Settings."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij beperkte fototoegang zijn sommige categorieën en albums niet beschikbaar. Via Wijzig of Instellingen pas je de toegang aan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con acceso limitado a las fotos, algunas categorías y álbumes no están disponibles. Ajusta el acceso en Cambiar o en Ajustes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei eingeschränktem Fotozugriff sind manche Kategorien und Alben nicht verfügbar. Über „Ändern“ oder die Einstellungen passt du den Zugriff an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un accès limité aux photos, certaines catégories et certains albums ne sont pas disponibles. Modifie l'accès via Modifier ou Réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真へのアクセスが制限されていると、一部のカテゴリやアルバムは使用できません。「変更」または「設定」でアクセスを変更できます。"
          }
        }
      }
    },
