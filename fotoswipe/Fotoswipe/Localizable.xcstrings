    "Slim opruimen zet burstfoto's, kopieën en rommel klaar, met de grootste winst bovenaan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart Clean lines up burst photos, copies and clutter, with the biggest savings at the top."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slim opruimen zet burstfoto's, kopieën en rommel klaar, met de grootste winst bovenaan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpieza inteligente prepara ráfagas, copias y desorden, con lo que más libera arriba."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Smart aufräumen“ sammelt Serienbilder, Kopien und Kram, die größte Ersparnis oben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyage intelligent prépare les rafales, les copies et le fouillis, avec le plus gros gain en haut."
          }
        },
        "ja": {
          "stringUnit": {
