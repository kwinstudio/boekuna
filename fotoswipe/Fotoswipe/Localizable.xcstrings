    "Niets is meteen weg: jij controleert eerst, iOS vraagt nog om bevestiging.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is gone right away: you review first, and iOS asks you to confirm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets is meteen weg: jij controleert eerst, iOS vraagt nog om bevestiging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada desaparece al instante: primero revisas tú y luego iOS te pide confirmación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts ist sofort weg: Du prüfst zuerst, iOS fragt noch einmal nach."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne disparaît tout de suite : tu vérifies d'abord, puis iOS demande confirmation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐには何も削除されません。まずあなたが確認し、さらにiOSが確認を求めます。"
          }
        }
      }
    },
    "Niets is meteen weg: verwijderde items staan nog 30 dagen in 'Recent verwijderd' in Foto's. Bij iCloud geldt dit ook voor je andere apparaten.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is gone right away: deleted items stay in 'Recently Deleted' in Photos for 30 days. With iCloud, this also applies to your other devices."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets is meteen weg: verwijderde items staan nog 30 dagen in 'Recent verwijderd' in Foto's. Bij iCloud geldt dit ook voor je andere apparaten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada desaparece al instante: los elementos eliminados permanecen 30 días en el álbum Eliminado de Fotos. Con iCloud, esto también se aplica a tus otros dispositivos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts ist sofort weg: Gelöschte Objekte bleiben 30 Tage in „Zuletzt gelöscht“ in Fotos. Mit iCloud gilt das auch für deine anderen Geräte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne disparaît tout de suite : les éléments supprimés restent 30 jours dans « Supprimés récemment » dans Photos. Avec iCloud, c'est valable aussi pour tes autres appareils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐには何も削除されません。削除した項目は「写真」の「最近削除した項目」に30日間残ります。iCloudを使用している場合は、ほかのデバイスにも適用されます。"
          }
        }
      }
    },
    "Niets voor later": {
