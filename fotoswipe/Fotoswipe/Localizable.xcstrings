    "Gewone foto opgeslagen, zonder het bewegende deel (ca. 1,5 MB kleiner). Het origineel staat bij Weggelegd, zodat jij beslist.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regular photo saved, without the moving part (approx. 1.5 MB smaller). The original is in Set aside, so you decide."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewone foto opgeslagen, zonder het bewegende deel (ca. 1,5 MB kleiner). Het origineel staat bij Weggelegd, zodat jij beslist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto normal guardada, sin la parte en movimiento (aprox. 1,5 MB menos). El original está en Apartadas, para que decidas tú."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normales Foto gesichert, ohne den bewegten Teil (ca. 1,5 MB kleiner). Das Original liegt bei „Beiseitegelegt“, damit du entscheidest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo classique enregistrée, sans la partie animée (env. 1,5 Mo de moins). L'original est dans De côté, pour que tu décides."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動く部分を除いた通常の写真として保存しました（約1.5 MB小さくなりました）。オリジナルは「よけた項目」にあるので、どうするかはあなたが決められます。"
          }
        }
      }
    },
