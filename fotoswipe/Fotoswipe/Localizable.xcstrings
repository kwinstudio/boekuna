    "Tik op 'Weggelegd' onderaan. Tik op een foto om hem toch te bewaren.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap 'Set aside' at the bottom. Tap a photo to keep it after all."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op 'Weggelegd' onderaan. Tik op een foto om hem toch te bewaren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca 'Apartadas' abajo. Toca una foto para conservarla de todos modos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe unten auf „Beiseitegelegt“. Tippe auf ein Foto, um es doch zu behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche « De côté » en bas. Touche une photo pour la garder finalement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部の「よけた項目」をタップします。写真をタップすると、やはり残すことができます。"
          }
        }
      }
    },
    "Tik op Focus: de foto vult het scherm en je swipet met gebaren.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Focus: the photo fills the screen and you swipe with gestures."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Focus: de foto vult het scherm en je swipet met gebaren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Enfoque: la foto llena la pantalla y deslizas con gestos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Fokus“: Das Foto füllt den Bildschirm und du swipest mit Gesten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche Focus : la photo remplit l'écran et tu swipes avec des gestes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「フォーカス」をタップすると、写真が全画面に表示され、ジェスチャでスワイプできます。"
          }
        }
      }
    },
    "Tik op Verwijder en bevestig in het venster van iOS.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Delete and confirm in the iOS dialog."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Verwijder en bevestig in het venster van iOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Eliminar y confirma en la ventana de iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Löschen“ und bestätige im iOS-Fenster."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche Supprimer et confirme dans la fenêtre d'iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「削除」をタップして、iOSのダイアログで確定します。"
          }
        }
      }
    },
    "Tik op een foto om details te bekijken. Kies daarna welke je wilt wegleggen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a photo to see details. Then choose which ones to set aside."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een foto om details te bekijken. Kies daarna welke je wilt wegleggen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una foto para ver los detalles. Luego elige cuáles quieres apartar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Foto, um Details zu sehen. Wähle dann, welche du beiseitelegen willst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche une photo pour voir les détails. Choisis ensuite celles à mettre de côté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真をタップすると詳細を表示できます。そのあと、よける写真を選んでください。"
          }
        }
      }
    },
    "Tik op een item om het te bekijken. Met Terug zet je het terug in de stapel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap an item to view it. Tap Back to put it back in the stack."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een item om het te bekijken. Met Terug zet je het terug in de stapel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un elemento para verlo. Con Devolver lo vuelves a poner en la pila."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Objekt, um es anzusehen. Mit „Zurück“ legst du es zurück in den Stapel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un élément pour le voir. Avec Retour, tu le remets dans la pile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目をタップすると表示できます。「戻す」で山に戻せます。"
          }
        }
      }
    },
    "Tip: kies volledige toegang om je hele bibliotheek op te ruimen. Een selectie kan ook.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: choose full access to clean up your whole library. A selection works too."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: kies volledige toegang om je hele bibliotheek op te ruimen. Een selectie kan ook."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: elige acceso completo para ordenar toda tu fototeca. También puedes elegir solo una selección."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Wähle vollen Zugriff, um deine ganze Mediathek aufzuräumen. Eine Auswahl geht auch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : choisis l'accès complet pour nettoyer toute ta photothèque. Une sélection, c'est possible aussi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント：ライブラリ全体を整理するにはフルアクセスを選んでください。一部の写真だけでも使えます。"
          }
        }
      }
    },
    "Toch weg": {
