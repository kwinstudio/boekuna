    "Toevoegen is niet gelukt. Je keuzes zijn bewaard.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't add. Your choices have been saved."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toevoegen is niet gelukt. Je keuzes zijn bewaard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo añadir. Tus decisiones se han guardado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzufügen fehlgeschlagen. Deine Entscheidungen sind gesichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l'ajout. Tes choix sont conservés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加できませんでした。選択内容は保持されています。"
          }
        }
