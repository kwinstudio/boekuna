    "Dan zie je alleen die foto's. Tik op 'Wijzig' boven de stapel om meer te kiezen, of geef volledige toegang in Instellingen > Privacy > Foto's.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then you'll only see those photos. Tap 'Edit' above the stack to choose more, or give full access in Settings > Privacy > Photos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan zie je alleen die foto's. Tik op 'Wijzig' boven de stapel om meer te kiezen, of geef volledige toegang in Instellingen > Privacy > Foto's."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entonces solo verás esas fotos. Toca 'Cambiar' encima de la pila para elegir más, o da acceso completo en Ajustes > Privacidad > Fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dann siehst du nur diese Fotos. Tippe über dem Stapel auf „Ändern“, um mehr auszuwählen, oder erlaube vollen Zugriff unter Einstellungen > Datenschutz > Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ne vois alors que ces photos. Touche « Modifier » au-dessus de la pile pour en choisir d'autres, ou donne l'accès complet dans Réglages > Confidentialité > Photos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その場合、選択した写真だけが表示されます。山の上の「変更」をタップして写真を追加するか、「設定」>「プライバシー」>「写真」でフルアクセスを許可してください。"
          }
        }
      }
    },
    "De foto kon niet worden geladen. Staat hij alleen in iCloud? Probeer het met internet opnieuw.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo couldn't be loaded. Is it only in iCloud? Try again with an internet connection."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De foto kon niet worden geladen. Staat hij alleen in iCloud? Probeer het met internet opnieuw."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar la foto. ¿Está solo en iCloud? Inténtalo de nuevo con conexión a internet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto konnte nicht geladen werden. Liegt es nur in iCloud? Versuche es mit Internet erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger la photo. Est-elle seulement dans iCloud ? Réessaie avec une connexion Internet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を読み込めませんでした。iCloudにのみ保存されている可能性があります。インターネットに接続してもう一度お試しください。"
          }
        }
      }
    },
    "De overige %lld items in %@ bewaren?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the other %1$lld items in %2$@?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De overige %lld items in %@ bewaren?"
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "¿Conservar el %lld elemento restante de %@?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "¿Conservar los %lld elementos restantes de %@?"
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Das übrige %lld Objekt in %@ behalten?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die übrigen %lld Objekte in %@ behalten?"
                }
              }
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder les %lld autres éléments de %@ ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@の残りの%1$lld件を残しますか？"
          }
        }
      }
    },
    "De scan werkt op dit apparaat met kleine, lokaal beschikbare voorbeelden. Foto's die alleen in iCloud staan worden overgeslagen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scan runs on this device using small, locally available previews. Photos that are only in iCloud are skipped."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De scan werkt op dit apparaat met kleine, lokaal beschikbare voorbeelden. Foto's die alleen in iCloud staan worden overgeslagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis funciona en este dispositivo con vistas previas pequeñas disponibles localmente. Se omiten las fotos que solo están en iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Scan läuft auf diesem Gerät mit kleinen, lokal verfügbaren Vorschauen. Fotos, die nur in iCloud liegen, werden übersprungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'analyse se fait sur cet appareil avec de petits aperçus disponibles en local. Les photos qui sont seulement dans iCloud sont ignorées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンはこのデバイス上で、ローカルにある小さなプレビューを使って行われます。iCloudにのみある写真はスキップされます。"
          }
        }
      }
    },
