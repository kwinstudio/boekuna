    },
    "Engels, Nederlands, Spaans, Duits, Frans of Japans. Kies je taal bij Instellingen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "English, Dutch, Spanish, German, French or Japanese. Choose your language in Settings."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Engels, Nederlands, Spaans, Duits, Frans of Japans. Kies je taal bij Instellingen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inglés, neerlandés, español, alemán, francés o japonés. Elige tu idioma en Ajustes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Englisch, Niederländisch, Spanisch, Deutsch, Französisch oder Japanisch. Wähle deine Sprache in den Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anglais, néerlandais, espagnol, allemand, français ou japonais. Choisis ta langue dans les réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英語、オランダ語、スペイン語、ドイツ語、フランス語、日本語に対応。設定で言語を選べます。"
          }
        }
      }
    },
    "Er staan geen contacten dubbel in je lijst.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of your contacts appear twice."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er staan geen contacten dubbel in je lijst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay contactos duplicados en tu lista."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deiner Liste gibt es keine doppelten Kontakte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun contact en double dans ta liste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重複した連絡先はありません。"
          }
        }
      }
    },
    "Er wordt alleen gezocht tussen foto's die binnen twee minuten van elkaar zijn gemaakt. De scan kan vergelijkbare foto's missen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only photos taken within two minutes of each other are compared. The scan may miss similar photos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt alleen gezocht tussen foto's die binnen twee minuten van elkaar zijn gemaakt. De scan kan vergelijkbare foto's missen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se buscan fotos tomadas con menos de dos minutos de diferencia. Es posible que el análisis no detecte algunas fotos parecidas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesucht wird nur unter Fotos, die innerhalb von zwei Minuten aufgenommen wurden. Der Scan kann ähnliche Fotos übersehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche ne porte que sur des photos prises à moins de deux minutes d'intervalle. L'analyse peut manquer des photos similaires."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2分以内に撮影された写真同士のみを検索します。似た写真を見逃す場合があります。"
          }
        }
      }
    },
    "Er wordt niets verwijderd. Je kunt het per item terugdraaien in Bekijken.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is deleted. You can undo this per item in Review."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt niets verwijderd. Je kunt het per item terugdraaien in Bekijken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se elimina nada. Puedes deshacerlo uno a uno en Revisar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nichts gelöscht. Unter „Prüfen“ kannst du das einzeln rückgängig machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est supprimé. Tu peux annuler élément par élément dans Vérifier."
