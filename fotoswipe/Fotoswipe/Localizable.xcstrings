    "Ze komen terug in de stapels. Weggelegde items blijven weggelegd.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They go back into the stacks. Set-aside items stay set aside."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze komen terug in de stapels. Weggelegde items blijven weggelegd."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelven a las pilas. Los elementos apartados siguen apartados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie kommen zurück in die Stapel. Beiseitegelegte Objekte bleiben beiseitegelegt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils reviennent dans les piles. Les éléments mis de côté restent de côté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "山に戻ります。よけた項目はよけたままです。"
          }
        }
      }
    },
    "Ze staan als knoppen onder de foto. Eén tik zet de foto in dat album en gaat door naar de volgende.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They appear as buttons under the photo. One tap files the photo in that album and moves on to the next."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze staan als knoppen onder de foto. Eén tik zet de foto in dat album en gaat door naar de volgende."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparecen como botones bajo la foto. Un toque guarda la foto en ese álbum y pasa a la siguiente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie erscheinen als Tasten unter dem Foto. Ein Tippen legt das Foto in das Album und zeigt das nächste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils apparaissent en boutons sous la photo. Un toucher range la photo dans cet album et passe à la suivante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の下にボタンとして表示されます。タップすると写真がそのアルバムに入り、次の写真に進みます。"
          }
        }
      }
    },
    "Ze staan nog 30 dagen in 'Recent verwijderd' in Foto's; pas daarna komt de ruimte vrij. Wil je de ruimte nu al? Open Foto's, ga naar Albums > Recent verwijderd en kies Verwijder alles.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They stay in 'Recently Deleted' in Photos for 30 days; only then is the space freed up. Want the space now? Open Photos, go to Albums > Recently Deleted and choose Delete All."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze staan nog 30 dagen in 'Recent verwijderd' in Foto's; pas daarna komt de ruimte vrij. Wil je de ruimte nu al? Open Foto's, ga naar Albums > Recent verwijderd en kies Verwijder alles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanecen 30 días en el álbum Eliminado de Fotos; solo después se libera el espacio. ¿Quieres el espacio ya? Abre Fotos, ve a Álbumes > Eliminado y elige Eliminar todo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie bleiben noch 30 Tage in „Zuletzt gelöscht“ in Fotos; erst danach wird der Platz frei. Willst du den Platz jetzt schon? Öffne Fotos, gehe zu Alben > Zuletzt gelöscht und wähle „Alle löschen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils restent encore 30 jours dans « Supprimés récemment » dans Photos ; l'espace n'est libéré qu'ensuite. Tu veux l'espace maintenant ? Ouvre Photos, va dans Albums > Supprimés récemment et choisis Tout supprimer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除した項目は「写真」の「最近削除した項目」に30日間残り、そのあとで容量が空きます。今すぐ容量を空けたい場合は、「写真」を開いて「アルバム」>「最近削除した項目」に移動し、「すべて削除」を選んでください。"
          }
        }
      }
    },
    "Zet in album %@ en bewaar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add to album %@ and keep"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet in album %@ en bewaar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir al álbum %@ y conservar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Album %@ hinzufügen und behalten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter à l'album %@ et garder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバム「%@」に追加して残す"
          }
        }
      }
    },
    "Zet tot 3 albums onder de foto. Eén tik en hij staat erin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin up to 3 albums under the photo. One tap and it's in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet tot 3 albums onder de foto. Eén tik en hij staat erin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija hasta 3 álbumes bajo la foto. Un toque y listo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu 3 Alben unter dem Foto. Ein Tippen und es ist drin."
          }
        },
        "fr": {
