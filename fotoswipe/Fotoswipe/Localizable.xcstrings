    "Focus (rechtsboven) toont alleen de foto op het hele scherm. Eén tik toont de knoppen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus (top right) shows only the photo, full screen. One tap shows the buttons."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus (rechtsboven) toont alleen de foto op het hele scherm. Eén tik toont de knoppen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfoque (arriba a la derecha) muestra solo la foto a pantalla completa. Un toque muestra los botones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus (oben rechts) zeigt nur das Foto im Vollbild. Einmal tippen zeigt die Tasten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus (en haut à droite) affiche seulement la photo en plein écran. Touche une fois pour voir les boutons."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス（右上）では写真だけを全画面で表示します。1回タップするとボタンが表示されます。"
          }
        }
      }
    },
