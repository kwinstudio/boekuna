    },
    "Grootste winst eerst. Alles gebeurt op je iPhone, en jij beslist per foto of per stapel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Biggest savings first. Everything happens on your iPhone, and you decide per photo or per stack."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grootste winst eerst. Alles gebeurt op je iPhone, en jij beslist per foto of per stapel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que más libera, primero. Todo ocurre en tu iPhone y tú decides por foto o por pila."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größte Ersparnis zuerst. Alles passiert auf deinem iPhone, und du entscheidest pro Foto oder pro Stapel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus gros gain d'abord. Tout se passe sur ton iPhone, et tu décides photo par photo ou pile par pile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "効果の大きいものから表示。すべてiPhone上で処理され、写真ごと、または山ごとにあなたが決められます。"
          }
        }
      }
    },
