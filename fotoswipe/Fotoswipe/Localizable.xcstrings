    "Rechts is bewaren, links is wegleggen. Twijfel? Tik op het klokje voor later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right is keep, left is set aside. Not sure? Tap the clock for later."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechts is bewaren, links is wegleggen. Twijfel? Tik op het klokje voor later."
