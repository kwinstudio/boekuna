    "Een paar minuten per dag houdt je bibliotheek licht.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few minutes a day keeps your library light."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een paar minuten per dag houdt je bibliotheek licht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos minutos al día mantienen ligera tu fototeca."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein paar Minuten am Tag halten deine Mediathek schlank."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques minutes par jour gardent ta photothèque légère."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日数分で、ライブラリをすっきり保てます。"
          }
        }
      }
    },
    "Een paar minuten per dag, en je bibliotheek blijft licht. Je foto's blijven in je eigen fotobibliotheek.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few minutes a day, and your library stays light. Your photos stay in your own photo library."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een paar minuten per dag, en je bibliotheek blijft licht. Je foto's blijven in je eigen fotobibliotheek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos minutos al día y tu fototeca se mantiene ligera. Tus fotos se quedan en tu propia fototeca."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein paar Minuten am Tag, und deine Mediathek bleibt schlank. Deine Fotos bleiben in deiner eigenen Fotomediathek."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques minutes par jour, et ta photothèque reste légère. Tes photos restent dans ta propre photothèque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日数分で、ライブラリをすっきり保てます。写真はあなたのフォトライブラリに保存されたままです。"
          }
        }
      }
    },
    "Een paar minuten swipen en ruimte maken voor nieuwe herinneringen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
