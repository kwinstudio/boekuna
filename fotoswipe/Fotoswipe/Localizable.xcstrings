    "Open een video of Live Photo en kies via Meer 'Video verkleinen' of 'Bewaar als gewone foto'. Het origineel gaat eerst naar Weggelegd.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a video or Live Photo and choose 'Shrink video' or 'Keep as regular photo' under More. The original goes to Set aside first."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open een video of Live Photo en kies via Meer 'Video verkleinen' of 'Bewaar als gewone foto'. Het origineel gaat eerst naar Weggelegd."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un vídeo o una Live Photo y, en Más, elige 'Reducir vídeo' o 'Conservar como foto normal'. El original va primero a Apartadas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne ein Video oder Live Photo und wähle unter „Mehr“ „Video verkleinern“ oder „Als normales Foto sichern“. Das Original kommt zuerst zu „Beiseitegelegt“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre une vidéo ou une Live Photo et choisis dans Plus « Réduire la vidéo » ou « Garder en photo classique ». L'original va d'abord dans De côté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオまたはLive Photosを開き、「その他」から「ビデオを縮小」または「通常の写真として保存」を選びます。オリジナルはまず「よけた項目」に移動します。"
          }
        }
      }
    },
