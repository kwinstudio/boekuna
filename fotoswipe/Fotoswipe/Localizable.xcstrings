    "Je opgeslagen keuzes konden niet worden gelezen. Verwijder pas foto's nadat je je selectie opnieuw hebt gecontroleerd.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved choices couldn't be read. Only delete photos after you've reviewed your selection again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je opgeslagen keuzes konden niet worden gelezen. Verwijder pas foto's nadat je je selectie opnieuw hebt gecontroleerd."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer tus decisiones guardadas. No elimines fotos hasta que vuelvas a revisar tu selección."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gesicherten Entscheidungen konnten nicht gelesen werden. Lösche Fotos erst, nachdem du deine Auswahl erneut geprüft hast."
          }
        },
        "fr": {
          "stringUnit": {
