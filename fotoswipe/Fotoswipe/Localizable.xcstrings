    "Vergelijkbare foto's zijn kandidaten, geen bewezen duplicaten. Vergelijk zelf en bewaar minstens één foto per groep.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Similar photos are candidates, not proven duplicates. Compare them yourself and keep at least one photo per group."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergelijkbare foto's zijn kandidaten, geen bewezen duplicaten. Vergelijk zelf en bewaar minstens één foto per groep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos parecidas son candidatas, no duplicados comprobados. Compáralas tú y conserva al menos una foto por grupo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ähnliche Fotos sind Kandidaten, keine sicheren Duplikate. Vergleiche selbst und behalte mindestens ein Foto pro Gruppe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos similaires sont des candidates, pas des doublons avérés. Compare toi-même et garde au moins une photo par groupe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "似た写真はあくまで候補で、重複と確定したものではありません。ご自身で比較して、各グループで少なくとも1枚は残してください。"
          }
        }
      }
    },
