          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een paar minuten swipen en ruimte maken voor nieuwe herinneringen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos minutos deslizando para hacer sitio a nuevos recuerdos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein paar Minuten swipen und Platz für neue Erinnerungen schaffen."
          }
        },
        "fr": {
