          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer contacto se queda y recibe los datos de los demás. Toca un grupo para omitirlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
