# DenkNote — configuratie
# Kopieer naar .env.local voor lokale ontwikkeling. Zet hier NOOIT geheime sleutels.

# ── App (publiek, mag in de appbundel) ───────────────────────────────────────
# Standaard wijst de app naar het Supabase-project "kwinest" (vuwfyhtejsxhdfyvkkeq).
EXPO_PUBLIC_SUPABASE_URL=https://vuwfyhtejsxhdfyvkkeq.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Edge Function-secrets (alleen op de server, via Supabase Dashboard of CLI) ─
# supabase secrets set --project-ref vuwfyhtejsxhdfyvkkeq OPENAI_API_KEY=...
# OPENAI_API_KEY=            (verplicht; staat al ingesteld in kwinest)
# DENKNOTE_MODEL=            (optioneel; standaard gpt-5.6-sol)
# OPENAI_RESPONSES_URL=      (optioneel; standaard https://api.openai.com/v1/responses)
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY worden door Supabase zelf gezet.

# ── GitHub Actions-secrets (voor TestFlight, al aanwezig in kwinstudio/boekuna) ─
# ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8
